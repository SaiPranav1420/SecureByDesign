        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "# SecureByDesign - Phase 4: Streamlit UI (Kaggle)\n",
                "Writes the frontend UI to disk. We cannot run `st.run()` directly in a notebook cell, so we write it to a Python script first."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "%%writefile /kaggle/working/SecureByDesign/app/streamlit_app.py\n",
                "\n",
                "\"\"\"\n",
                "SecureByDesign — Streamlit Demo UI\n",
                "AI-Assisted Architectural Security Reasoning Framework\n",
                "\"\"\"\n",
                "import streamlit as st\n",
                "import json\n",
                "import sys\n",
                "import time\n",
                "from datetime import datetime\n",
                "\n",
                "sys.path.append('/kaggle/working/SecureByDesign')\n",
                "\n",
                "st.set_page_config(\n",
                "    page_title=\"SecureByDesign | AI Threat Modeling\",\n",
                "    page_icon=\"\\ud83d\\udd10\",\n",
                "    layout=\"wide\",\n",
                "    initial_sidebar_state=\"expanded\"\n",
                ")\n",
                "\n",
                "st.markdown(\"\"\"\n",
                "<style>\n",
                "    .stApp { background-color: #0f1117; color: #e0e0e0; }\n",
                "    .stride-badge {\n",
                "        display: inline-block;\n",
                "        padding: 3px 10px;\n",
                "        border-radius: 12px;\n",
                "        font-size: 12px;\n",
                "        font-weight: bold;\n",
                "        margin: 2px;\n",
                "    }\n",
                "    .stride-Spoofing { background-color: #8B1A1A; color: white; }\n",
                "    .stride-Tampering { background-color: #8B5E1A; color: white; }\n",
                "    .stride-Repudiation { background-color: #5E8B1A; color: white; }\n",
                "    .stride-Information-Disclosure { background-color: #1A5E8B; color: white; }\n",
                "    .stride-Denial-of-Service { background-color: #5E1A8B; color: white; }\n",
                "    .stride-Elevation-of-Privilege { background-color: #8B1A6B; color: white; }\n",
                "    \n",
                "    .risk-Critical { background: #ff0000; color: white; padding: 4px 12px; border-radius: 6px; font-weight: bold; }\n",
                "    .risk-High { background: #ff6600; color: white; padding: 4px 12px; border-radius: 6px; font-weight: bold; }\n",
                "    .risk-Medium { background: #ffaa00; color: black; padding: 4px 12px; border-radius: 6px; font-weight: bold; }\n",
                "    .risk-Low { background: #00aa44; color: white; padding: 4px 12px; border-radius: 6px; font-weight: bold; }\n",
                "    \n",
                "    .metric-card {\n",
                "        background: #1a1d27;\n",
                "        border-radius: 8px;\n",
                "        padding: 16px;\n",
                "        text-align: center;\n",
                "        border: 1px solid #2d3148;\n",
                "    }\n",
                "    .metric-value { font-size: 32px; font-weight: bold; color: #7eb8f7; }\n",
                "    .metric-label { font-size: 13px; color: #888; margin-top: 4px; }\n",
                "</style>\n",
                "\"\"\", unsafe_allow_html=True)\n",
                "\n",
                "SAMPLE_COMPLETE_DFD = {\n",
                "    \"dfd_id\": \"demo_payment_001\",\n",
                "    \"system_name\": \"Payment Processing Microservice\",\n",
                "    \"nodes\": [\n",
                "        {\"id\": \"N1\", \"type\": \"external_entity\", \"name\": \"Mobile App\", \"description\": \"Customer mobile application\"},\n",
                "        {\"id\": \"N2\", \"type\": \"process\", \"name\": \"API Gateway\", \"description\": \"Central request router\"},\n",
                "        {\"id\": \"N3\", \"type\": \"process\", \"name\": \"Payment Service\", \"description\": \"Payment processing logic\"}\n",
                "    ],\n",
                "    \"edges\": [\n",
                "        {\"id\": \"E1\", \"from\": \"N1\", \"to\": \"N2\", \"data_description\": \"Payment requests\", \"protocol\": \"HTTPS\", \"authenticated\": None, \"encrypted\": True},\n",
                "        {\"id\": \"E2\", \"from\": \"N2\", \"to\": \"N3\", \"data_description\": \"Validated request\", \"protocol\": \"HTTP\", \"authenticated\": False, \"encrypted\": False}\n",
                "    ],\n",
                "    \"trust_boundaries\": [\n",
                "        {\"id\": \"TB1\", \"name\": \"Internet Perimeter\", \"separates\": [\"N1\", \"N2\"]}\n",
                "    ],\n",
                "    \"partial_info_flags\": {\"missing_trust_boundaries\": False, \"unknown_protocols\": False, \"unspecified_auth\": True, \"incomplete_nodes\": False}\n",
                "}\n",
                "\n",
                "SAMPLE_PARTIAL_DFD = {\n",
                "    \"dfd_id\": \"demo_partial_001\",\n",
                "    \"system_name\": \"Payment Processing Microservice (Partial Design)\",\n",
                "    \"nodes\": [\n",
                "        {\"id\": \"N1\", \"type\": \"external_entity\", \"name\": \"Mobile App\"},\n",
                "        {\"id\": \"N2\", \"type\": \"process\", \"name\": \"API Gateway\"},\n",
                "        {\"id\": \"N3\", \"type\": \"process\", \"name\": \"Payment Service\"}\n",
                "    ],\n",
                "    \"edges\": [\n",
                "        {\"id\": \"E1\", \"from\": \"N1\", \"to\": \"N2\", \"data_description\": \"Payment requests\", \"protocol\": None, \"authenticated\": None, \"encrypted\": None},\n",
                "        {\"id\": \"E2\", \"from\": \"N2\", \"to\": \"N3\", \"data_description\": \"Payment request\", \"protocol\": None, \"authenticated\": None, \"encrypted\": None}\n",
                "    ],\n",
                "    \"trust_boundaries\": [],\n",
                "    \"partial_info_flags\": {\"missing_trust_boundaries\": True, \"unknown_protocols\": True, \"unspecified_auth\": True, \"incomplete_nodes\": True}\n",
                "}\n",
                "\n",
                "with st.sidebar:\n",
                "    st.markdown(\"## \\ud83d\\udd10 SecureByDesign\")\n",
                "    st.markdown(\"### Quick Load\")\n",
                "    if st.button(\"\\ud83d\\udccb Load Complete DFD Example\"):\n",
                "        st.session_state['loaded_dfd'] = json.dumps(SAMPLE_COMPLETE_DFD, indent=2)\n",
                "    if st.button(\"\\u26a0\\ufe0f Load Partial DFD Example\"):\n",
                "        st.session_state['loaded_dfd'] = json.dumps(SAMPLE_PARTIAL_DFD, indent=2)\n",
                "\n",
                "st.markdown(\"# \\ud83d\\udd10 SecureByDesign\")\n",
                "st.divider()\n",
                "\n",
                "col1, col2 = st.columns([3, 2])\n",
                "with col1:\n",
                "    dfd_input = st.text_area(\"Paste your DFD JSON:\", value=st.session_state.get('loaded_dfd', json.dumps(SAMPLE_COMPLETE_DFD, indent=2)), height=350)\n",
                "with col2:\n",
                "    security_context = st.text_area(\"Security Context:\", height=150)\n",
                "    analyze_button = st.button(\"\\ud83d\\udd0d Analyze for Threats\", type=\"primary\", use_container_width=True)\n",
                "\n",
                "if analyze_button:\n",
                "    try:\n",
                "        dfd_json = json.loads(dfd_input)\n",
                "        from pipeline.inference import analyze_dfd\n",
                "        with st.spinner(\"Analyzing... (Ensure Person A has pushed their code)\"):\n",
                "            result = analyze_dfd(dfd_json, security_context)\n",
                "            st.json(result)\n",
                "    except Exception as e:\n",
                "        st.error(f\"\\u274c Error: {str(e)}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "### Phase 5: Demo Web Server via localtunnel / Ngrok\n",
                "Uses Kaggle Secrets (`NGROK_TOKEN`) to tunnel `localhost:8501` to the public internet."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "!pip install pyngrok --quiet\n",
                "\n",
                "from pyngrok import ngrok\n",
                "from kaggle_secrets import UserSecretsClient\n",
                "import subprocess\n",
                "import time\n",
                "\n",
                "try:\n",
                "    user_secrets = UserSecretsClient()\n",
                "    ngrok_token = user_secrets.get_secret(\"NGROK_TOKEN\")\n",
                "    ngrok.set_auth_token(ngrok_token)\n",
                "except:\n",
                "    print(\"\\u26a0\\ufe0f WARNING: NGROK_TOKEN secret not found in Kaggle! The app will start but without a public URL.\")\n",
                "\n",
                "ngrok.kill()\n",
                "\n",
                "print(\"\\u23f3 Starting Streamlit UI...\")\n",
                "streamlit_process = subprocess.Popen([\n",
                "    'streamlit', 'run', \n",
                "    '/kaggle/working/SecureByDesign/app/streamlit_app.py',\n",
                "    '--server.port', '8501',\n",
                "    '--server.headless', 'true',\n",
                "    '--browser.gatherUsageStats', 'false'\n",
                "])\n",
                "\n",
                "time.sleep(5) # Wait for webserver to boot\n",
                "\n",
                "try:\n",
                "    public_url = ngrok.connect(8501)\n",
                "    print(\"\\n\" + \"=\" * 60)\n",
                "    print(f\"\\ud83d\\udd10 SecureByDesign Public URL: {public_url}\")\n",
                "    print(\"=\" * 60 + \"\\n\")\n",
                "    print(\"Click the link above to test the Demo! Keep this cell running.\")\n",
                "except Exception as e:\n",
                "    print(f\"Failed to tunnel: {e}\")"
            ]
        }
    ],
