            "source": [
                "# SecureByDesign - Phase 1: Environment & Repository Setup (Kaggle)\n",
                "This notebook contains the exact commands required by Person B to initialize the `SecureByDesign` project directory within a Kaggle Notebook environment (`/kaggle/working/`)."
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "### Step 1.1 — Install Dependencies"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "!pip install streamlit pyngrok scikit-learn pandas matplotlib seaborn --quiet\n",
                "\n",
                "import sklearn\n",
                "import pandas\n",
                "import streamlit\n",
                "\n",
                "print(f\"\\u2705 All packages installed\")\n",
                "print(f\"scikit-learn: {sklearn.__version__}\")\n",
                "print(f\"pandas: {pandas.__version__}\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "### Step 1.2 — Initialize Local Repository Structure\n",
                "Sets up the required folder architecture in Kaggle's working directory."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "import os\n",
                "\n",
                "# Create folder structure\n",
                "folders = [\n",
                "    '/kaggle/working/SecureByDesign/evaluation/test_dfds',\n",
                "    '/kaggle/working/SecureByDesign/evaluation/results',\n",
                "    '/kaggle/working/SecureByDesign/app',\n",
                "    '/kaggle/working/SecureByDesign/data',\n",
                "    '/kaggle/working/SecureByDesign/pipeline',\n",
                "]\n",
                "\n",
                "for folder in folders:\n",
                "    os.makedirs(folder, exist_ok=True)\n",
                "    \n",
                "print(\"\\u2705 Repository structure created\")\n",
                "print(os.listdir('/kaggle/working/SecureByDesign'))"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "### Step 1.3 — Create the Sacred Contract File\n",
                "Writes the agreed-upon JSON schema data contract to `/kaggle/working/SecureByDesign/contract.json`."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "import json\n",
                "\n",
                "contract = {\n",
                "    \"description\": \"SecureByDesign Data Contract — DO NOT MODIFY WITHOUT TEAM AGREEMENT\",\n",
                "    \"version\": \"1.0\",\n",
                "    \"input_schema\": {\n",
                "        \"dfd_id\": \"string\",\n",
                "        \"system_name\": \"string\",\n",
                "        \"nodes\": [{\"id\": \"string\", \"type\": \"external_entity|process|datastore\", \"name\": \"string\", \"description\": \"string|null\"}],\n",
                "        \"edges\": [{\"id\": \"string\", \"from\": \"string\", \"to\": \"string\", \"data_description\": \"string|null\", \"protocol\": \"string|null\", \"authenticated\": \"boolean|null\", \"encrypted\": \"boolean|null\"}],\n",
                "        \"trust_boundaries\": [{\"id\": \"string\", \"name\": \"string\", \"separates\": [\"node_id\"]}],\n",
                "        \"partial_info_flags\": {\"missing_trust_boundaries\": \"boolean\", \"unknown_protocols\": \"boolean\", \"unspecified_auth\": \"boolean\", \"incomplete_nodes\": \"boolean\"}\n",
                "    },\n",
                "    \"output_schema\": {\n",
                "        \"dfd_id\": \"string\",\n",
                "        \"system_name\": \"string\",\n",
                "        \"analysis_timestamp\": \"ISO8601\",\n",
                "        \"overall_risk_level\": \"Critical|High|Medium|Low\",\n",
                "        \"partial_dfd_detected\": \"boolean\",\n",
                "        \"completeness_score\": \"float 0.0-1.0\",\n",
                "        \"threats\": [{\"threat_id\": \"string\", \"stride_category\": \"exact STRIDE name\", \"affected_component\": \"string\", \"threat_description\": \"string\", \"missing_control\": \"string\", \"confidence\": \"High|Medium|Low\", \"confidence_reason\": \"string\", \"explanation\": \"string\"}],\n",
                "        \"missing_controls_summary\": [\"string\"],\n",
                "        \"stride_coverage\": {\"Spoofing\": \"int\", \"Tampering\": \"int\", \"Repudiation\": \"int\", \"Information Disclosure\": \"int\", \"Denial of Service\": \"int\", \"Elevation of Privilege\": \"int\"}\n",
                "    }\n",
                "}\n",
                "\n",
                "with open('/kaggle/working/SecureByDesign/contract.json', 'w') as f:\n",
                "    json.dump(contract, f, indent=2)\n",
                "\n",
                "print(\"\\u2705 Contract file written\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "### Step 1.4 — Clone Dataset\n",
                "Clones `microSecEnD` directly into the Kaggle environment."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "!git clone https://github.com/tuhh-softsec/microSecEnD /kaggle/working/SecureByDesign/data/microSecEnD 2>/dev/null || echo \"Already cloned\"\n",
                "\n",
                "import os\n",
                "data_path = '/kaggle/working/SecureByDesign/data/microSecEnD'\n",
                "all_files = []\n",
                "for root, dirs, files in os.walk(data_path):\n",
                "    for file in files:\n",
                "        all_files.append(os.path.join(root, file))\n",
                "\n",
                "print(f\"\\u2705 Dataset loaded. Total files: {len(all_files)}\")\n",
                "\n",
                "dfd_files = [f for f in all_files if any(ext in f.lower() for ext in ['.json', '.xml', '.yaml', '.yml', '.md'])]\n",
                "print(f\"DFD-related files: {len(dfd_files)}\")\n",
                "print(\"Sample paths:\")\n",
                "for f in dfd_files[:10]:\n",
                "    print(f\"  {f}\")"
            ]
        }
    ],
