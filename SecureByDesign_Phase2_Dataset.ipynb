            "metadata": {},
            "source": [
                "# SecureByDesign - Phase 2: Dataset Preparation (Kaggle)\n",
                "This notebook contains the adapter required to transform the raw `microSecEnD` dataset into the `SecureByDesign` data contract schema for testing."
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "### Step 2.1 — Build the microSecEnD Adapter\n",
                "Parses the existing microservice models and standardizes them."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "import json\n",
                "import os\n",
                "from pathlib import Path\n",
                "\n",
                "def adapt_microsecend_dfd(raw_dfd: dict, dfd_id: str) -> dict:\n",
                "    \"\"\"\n",
                "    Convert a microSecEnD DFD into SecureByDesign input format.\n",
                "    Maps specific terms from the JSON to our standardized vocabulary.\n",
                "    \"\"\"\n",
                "    nodes = []\n",
                "    edges = []\n",
                "    trust_boundaries = []\n",
                "    \n",
                "    # Standardize nodes\n",
                "    # microSecEnD lists its main elements usually under \"nodes\", \"components\", or \"services\"\n",
                "    raw_components = raw_dfd.get('components', raw_dfd.get('nodes', raw_dfd.get('services', [])))\n",
                "    \n",
                "    for i, component in enumerate(raw_components):\n",
                "        node_type = 'process'  \n",
                "        \n",
                "        # Infer node type from names/stereotypes\n",
                "        comp_name = str(component.get('name', component.get('label', f'Component_{i}'))).lower()\n",
                "        stereotypes = [s.lower() for s in component.get('stereotypes', [])]\n",
                "        \n",
                "        if any(word in comp_name for word in ['database', 'db', 'store', 'storage', 'cache', 'redis', 'mongo']) or 'database' in stereotypes:\n",
                "            node_type = 'datastore'\n",
                "        elif any(word in comp_name for word in ['user', 'client', 'browser', 'mobile', 'external', 'actor', 'gateway']) or 'external' in stereotypes:\n",
                "            node_type = 'external_entity'\n",
                "        \n",
                "        nodes.append({\n",
                "            \"id\": f\"N{i+1}\",\n",
                "            \"type\": node_type,\n",
                "            \"name\": component.get('name', component.get('label', f'Component_{i}')),\n",
                "            \"description\": \", \".join(component.get('stereotypes', [])) if component.get('stereotypes') else None\n",
                "        })\n",
                "    \n",
                "    node_name_to_id = {n['name']: n['id'] for n in nodes}\n",
                "    \n",
                "    # Standardize edges\n",
                "    raw_flows = raw_dfd.get('links', raw_dfd.get('flows', raw_dfd.get('edges', raw_dfd.get('dataflows', []))))\n",
                "    for j, flow in enumerate(raw_flows):\n",
                "        from_name = flow.get('source', flow.get('from', flow.get('sender', '')))\n",
                "        to_name = flow.get('target', flow.get('to', flow.get('receiver', '')))\n",
                "        \n",
                "        # Infer protocol and encryption from stereotypes and tagged values\n",
                "        protocol = None\n",
                "        encrypted = None\n",
                "        stereotypes = [s.lower() for s in flow.get('stereotypes', [])]\n",
                "        \n",
                "        if 'https' in stereotypes or 'restful_http' in stereotypes:\n",
                "            protocol = 'HTTPS'\n",
                "            encrypted = True\n",
                "        elif 'http' in stereotypes:\n",
                "            protocol = 'HTTP'\n",
                "            encrypted = False\n",
                "            \n",
                "        edges.append({\n",
                "            \"id\": f\"E{j+1}\",\n",
                "            \"from\": node_name_to_id.get(from_name, from_name),\n",
                "            \"to\": node_name_to_id.get(to_name, to_name),\n",
                "            \"data_description\": flow.get('data', flow.get('label', flow.get('name', None))),\n",
                "            \"protocol\": protocol,\n",
                "            \"authenticated\": True if 'authenticated' in stereotypes else None,\n",
                "            \"encrypted\": encrypted\n",
                "        })\n",
                "    \n",
                "    # Note: microSecEnD rarely explicitly models trust boundaries in the same way.\n",
                "    # We log missing_trust_boundaries = True naturally here to trigger the Novel Contribution.\n",
                "    \n",
                "    # Compute partial_info_flags\n",
                "    has_null_auth = any(e.get('authenticated') is None for e in edges)\n",
                "    has_null_proto = any(e.get('protocol') is None for e in edges)\n",
                "    \n",
                "    return {\n",
                "        \"dfd_id\": dfd_id,\n",
                "        \"system_name\": raw_dfd.get('name', raw_dfd.get('system', dfd_id)),\n",
                "        \"nodes\": nodes,\n",
                "        \"edges\": edges,\n",
                "        \"trust_boundaries\": [],\n",
                "        \"partial_info_flags\": {\n",
                "            \"missing_trust_boundaries\": True,\n",
                "            \"unknown_protocols\": has_null_proto,\n",
                "            \"unspecified_auth\": has_null_auth,\n",
                "            \"incomplete_nodes\": False\n",
                "        }\n",
                "    }\n",
                "\n",
                "def batch_convert_microsecend(data_path: str, output_path: str, max_dfds: int = 15):\n",
                "    \"\"\"Convert microSecEnD DFDs to SecureByDesign format and save to test_dfds/.\"\"\"\n",
                "    os.makedirs(output_path, exist_ok=True)\n",
                "    \n",
                "    converted = 0\n",
                "    failed = 0\n",
                "    \n",
                "    for root, dirs, files in os.walk(data_path):\n",
                "        if converted >= max_dfds:\n",
                "            break\n",
                "            \n",
                "        for filename in files:\n",
                "            if converted >= max_dfds:\n",
                "            \tbreak\n",
                "            if not (filename.endswith('.json')):\n",
                "                continue\n",
                "                \n",
                "            filepath = os.path.join(root, filename)\n",
                "            \n",
                "            try:\n",
                "                with open(filepath) as f:\n",
                "                    raw_dfd = json.load(f)\n",
                "                \n",
                "                nodes_count = len(raw_dfd.get('components', raw_dfd.get('nodes', raw_dfd.get('services', []))))\n",
                "                if nodes_count < 2:\n",
                "                    continue\n",
                "                \n",
                "                dfd_id = f\"msend_{converted+1:03d}\"\n",
                "                adapted = adapt_microsecend_dfd(raw_dfd, dfd_id)\n",
                "                \n",
                "                if len(adapted['nodes']) < 2 or len(adapted['edges']) < 1:\n",
                "                    continue\n",
                "                \n",
                "                output_file = os.path.join(output_path, f\"{dfd_id}.json\")\n",
                "                with open(output_file, 'w') as f:\n",
                "                    json.dump(adapted, f, indent=2)\n",
                "                \n",
                "                converted += 1\n",
                "                print(f\"\\u2705 Converted {filename} \\u2192 {dfd_id} ({len(adapted['nodes'])} nodes, {len(adapted['edges'])} edges)\")\n",
                "                \n",
                "            except Exception as e:\n",
                "                failed += 1\n",
                "    \n",
                "    print(f\"\\n=== CONVERSION COMPLETE ===\")\n",
                "    print(f\"Converted: {converted} DFDs\")\n",
                "    return converted\n",
                "\n",
                "# Execute the conversion\n",
                "if __name__ == \"__main__\":\n",
                "    converted_count = batch_convert_microsecend(\n",
                "        data_path='/kaggle/working/SecureByDesign/data/microSecEnD',\n",
                "        output_path='/kaggle/working/SecureByDesign/evaluation/test_dfds',\n",
                "        max_dfds=15\n",
                "    )"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "### Step 2.4 — Establish Ground Truth Labels (Critical Baseline)\n",
                "Defines what threats *should* be detected for each converted DFD to calculate precision/recall."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
